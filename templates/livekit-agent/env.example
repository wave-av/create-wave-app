# Your WAVE API key (wave_live_...). Required.
WAVE_AGENT_KEY=
# Your LiveKit Cloud project. Required. The default speech-to-text, LLM and
# text-to-speech run on LiveKit Inference, which only LiveKit Cloud provides; a
# self-hosted LiveKit server needs provider plugins instead (see README.md).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set to 1 to give the agent the WAVE tools that change things (create streams
# and clips, switch sources, show graphics, control cameras, ...). Anyone who can
# talk in the room can then make it use them with your WAVE key. Default: read-only.
WAVE_AGENT_ALLOW_ACTIONS=0
