# Your WAVE API key (wave_live_...). Required.
WAVE_AGENT_KEY=
# Stream ids to watch, separated by commas. Required.
WAVE_STREAM_IDS=
# How often to poll each stream, in milliseconds (whole number, at least 1000).
WAVE_POLL_INTERVAL_MS=30000
# Set to 1 to restart a stream (POST /v1/streams/{id}/start) when it drops from live.
WAVE_AUTO_REMEDIATE=0
# Port for the health endpoint (GET /health).
HEALTH_PORT=8080
# Optional: your own log collector URL. Leave empty to log to stdout only.
WAVE_LOG_FORWARD_URL=
